<!DOCTYPE html>
<html>
<head>
  <title>Sign Up | HireAI</title>
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <link rel="stylesheet" href="/css/output.css">
</head>
<body>
  <%- include("../partials/navbar") %>

  <main class="app-shell py-8 sm:py-12">
    <section class="card mx-auto max-w-xl p-6 sm:p-8">
      <h1 class="page-title">Create Account</h1>
      <p class="page-subtitle">Sign up to start practicing mock interviews with AI.</p>

      <form method="POST" action="/signup" class="mt-6 space-y-5">
        <div>
          <label class="mb-2 block text-sm font-medium text-[#1F2937]">Username</label>
          <input type="text" name="username" required class="input" />
        </div>
        <div>
          <label class="mb-2 block text-sm font-medium text-[#1F2937]">Email</label>
          <input type="email" name="email" required class="input" />
        </div>
        <div>
          <label class="mb-2 block text-sm font-medium text-[#1F2937]">Password</label>
          <input type="password" name="password" required class="input" />
        </div>
        <button type="submit" class="btn-primary w-full">Create Account</button>
      </form>

      <p class="mt-5 text-center text-sm text-[#4B5563]">
        Already have an account?
        <a href="/login" class="font-semibold text-[#F97316] hover:text-[#EA580C]">Login</a>
      </p>
    </section>
  </main>
</body>
</html>
