<!DOCTYPE html>
<html>
<head>
  <title>Auth | HireAI</title>
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <link rel="stylesheet" href="/css/output.css">
</head>
<body>
  <%- include("../partials/navbar") %>

  <main class="app-shell py-8 sm:py-12">
    <section class="card mx-auto max-w-xl p-6 sm:p-8">
      <div class="rounded-xl bg-[#F5EDE6] p-1">
        <div class="grid grid-cols-2 gap-1">
          <button id="loginToggle" class="rounded-lg bg-white px-3 py-2 text-sm font-semibold text-[#1F2937] shadow-sm">Login</button>
          <button id="signupToggle" class="rounded-lg px-3 py-2 text-sm font-semibold text-[#6B7280]">Sign Up</button>
        </div>
      </div>

      <div id="loginForm" class="mt-6">
        <h1 class="page-title">Welcome Back</h1>
        <p class="page-subtitle">Login to continue your mock interview practice.</p>
        <form method="POST" action="/login" class="mt-6 space-y-5">
          <div>
            <label class="mb-2 block text-sm font-medium text-[#1F2937]">Email</label>
            <input type="email" name="email" required class="input" />
          </div>
          <div>
            <label class="mb-2 block text-sm font-medium text-[#1F2937]">Password</label>
            <input type="password" name="password" required class="input" />
          </div>
          <button type="submit" class="btn-primary w-full">Login</button>
        </form>
      </div>

      <div id="signupForm" class="mt-6 hidden">
        <h1 class="page-title">Create Account</h1>
        <p class="page-subtitle">Sign up to start practicing mock interviews with AI.</p>
        <form method="POST" action="/signup" class="mt-6 space-y-5">
          <div>
            <label class="mb-2 block text-sm font-medium text-[#1F2937]">Username</label>
            <input type="text" name="username" required class="input" />
          </div>
          <div>
            <label class="mb-2 block text-sm font-medium text-[#1F2937]">Email</label>
            <input type="email" name="email" required class="input" />
          </div>
          <div>
            <label class="mb-2 block text-sm font-medium text-[#1F2937]">Password</label>
            <input type="password" name="password" required class="input" />
          </div>
          <button type="submit" class="btn-primary w-full">Create Account</button>
        </form>
      </div>
    </section>
  </main>

  <script>
    const loginToggle = document.getElementById("loginToggle");
    const signupToggle = document.getElementById("signupToggle");
    const loginForm = document.getElementById("loginForm");
    const signupForm = document.getElementById("signupForm");

    function setActive(type) {
      const loginActive = type === "login";
      loginForm.classList.toggle("hidden", !loginActive);
      signupForm.classList.toggle("hidden", loginActive);
      loginToggle.className = loginActive
        ? "rounded-lg bg-white px-3 py-2 text-sm font-semibold text-[#1F2937] shadow-sm"
        : "rounded-lg px-3 py-2 text-sm font-semibold text-[#6B7280]";
      signupToggle.className = !loginActive
        ? "rounded-lg bg-white px-3 py-2 text-sm font-semibold text-[#1F2937] shadow-sm"
        : "rounded-lg px-3 py-2 text-sm font-semibold text-[#6B7280]";
    }

    loginToggle.addEventListener("click", () => setActive("login"));
    signupToggle.addEventListener("click", () => setActive("signup"));
  </script>
</body>
</html>
