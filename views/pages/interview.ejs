<!DOCTYPE html>
<html>
<head>
  <title>HireAI | Interview</title>
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <link rel="stylesheet" href="/css/output.css">

  <!-- ✅ CUSTOM BUTTON CSS -->
  <style>
    .mic-btn {
      background: linear-gradient(135deg, #3b82f6, #2563eb);
      color: white;
      padding: 10px 18px;
      border-radius: 8px;
      font-weight: 600;
      margin-bottom: 10px;
      transition: 0.3s;
      width: 100%;
    }

    .mic-btn:hover {
      transform: scale(1.05);
    }

    .mic-btn.active-mic {
      background: red;
    }

    .submit-btn {
      background: linear-gradient(135deg, #10b981, #059669);
      color: white;
      padding: 12px 20px;
      border-radius: 8px;
      font-weight: bold;
      margin-top: 10px;
      transition: 0.3s;
      width: 100%;
    }

    .submit-btn:hover {
      transform: scale(1.05);
    }
  </style>
</head>

<body>
  <%- include("../partials/navbar") %>

  <main class="app-shell py-8 sm:py-12">
    <section class="card mx-auto max-w-5xl p-6 sm:p-8">
      
      <h1 class="page-title">Mock Interview</h1>

      <!-- Role + Level -->
      <div class="mt-5 grid grid-cols-2 gap-3 rounded-xl border border-[#9CA3AF]/40 bg-white p-4 text-sm">
        <p class="rounded-lg border border-[#9CA3AF]/30 bg-[#F9FAFB] px-3 py-2">
          <span class="font-semibold">Role:</span> <%= role %>
        </p>
        <p class="rounded-lg border border-[#9CA3AF]/30 bg-[#F9FAFB] px-3 py-2">
          <span class="font-semibold">Level:</span> <%= level %>
        </p>
      </div>

      <!-- Hidden data -->
      <div id="interview-data" data-role="<%= role %>" data-level="<%= level %>"></div>

      <!-- MAIN -->
      <div class="mt-6 border-t border-[#9CA3AF]/40 pt-6 flex flex-col lg:flex-row gap-6">

        <!-- LEFT -->
        <div class="flex-1">

          <p id="progress" class="text-sm font-medium text-[#6B7280]"></p>

          <p id="question" class="mt-2 text-lg font-medium text-[#1F2937]">
            Loading question...
          </p>

          <!-- TIMER -->
          <p id="timer" class="mt-2 text-sm font-semibold text-blue-600">
            Time: 0s
          </p>

          <!-- WARNING -->
          <p id="warningBox" class="mt-2 text-sm font-semibold text-red-600"></p>

          <!-- ANSWER -->
          <div class="mt-6">
            <label class="mb-2 block text-sm font-medium text-[#1F2937]">
              Your Answer
            </label>

            <!-- ✅ SPEAK BUTTON (FIXED POSITION) -->
            <button id="micBtn" class="mic-btn">
              🎤 Speak Answer
            </button>

            <textarea 
              id="answer" 
              rows="6" 
              class="input resize-y w-full border rounded p-2"
              placeholder="Write or speak your answer..."
            ></textarea>
          </div>

          <!-- ✅ SUBMIT BUTTON -->
          <button id="submitBtn" class="submit-btn">
            Submit Answer
          </button>

        </div>

        <!-- RIGHT (WEBCAM) -->
        <div class="w-full lg:w-64 text-center border border-gray-300 rounded-lg p-3 bg-gray-50">

          <h4 class="text-sm font-semibold mb-2 text-gray-700">
            Live Camera
          </h4>

          <video 
            id="webcam" 
            autoplay 
            playsinline 
            class="rounded-lg w-full border"
          ></video>

        </div>

      </div>

    </section>
  </main>

  <footer class="app-shell py-8 text-center text-sm text-[#6B7280]">
    &copy; <%= new Date().getFullYear() %> HireAI · AI-powered mock interviews
  </footer>

  <script src="/js/interview.js"></script>
</body>
</html>