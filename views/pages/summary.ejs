<!DOCTYPE html>
<html>

<head>
  <title>HireAi | Interview Summary</title>
  <link rel="stylesheet" href="/css/style.css">
</head>

<body>

  <%- include("../partials/navbar") %>

    <div class="container">
      <h2>Interview Summary</h2>

      <div class="meta">
        <p><strong>Role:</strong>
          <%= interview.role %>
        </p>
        <p><strong>Level:</strong>
          <%= interview.level %>
        </p>
      </div>

      <p>
        <strong>Average Score:</strong>
        <span class="score <%= interview.averageScore >= 7 ? 'good' : interview.averageScore >= 4 ? 'avg' : 'bad' %>">
          <%= interview.averageScore %> / 10
        </span>
      </p>

      <hr />

      <% interview.questions.forEach((q, index)=> { %>
        <h3>Question <%= index + 1 %>
        </h3>
        <p><strong>Question:</strong>
          <%= q.question %>
        </p>

        <p><strong>Your Answer:</strong></p>
        <p>
          <%= q.answer %>
        </p>

        <p><strong>Feedback:</strong></p>
        <pre><%= q.feedback %></pre>

        <p>
          <strong>Score:</strong>
          <span class="score <%= q.score >= 7 ? 'good' : q.score >= 4 ? 'avg' : 'bad' %>">
            <%= q.score %> / 10
          </span>
        </p>

        <hr />
        <% }) %>

          <a href="/setup" class="btn">Start New Interview</a>
          <a href="/summary/<%= interview._id %>/pdf" class="btn btn-outline" style="margin-top: 20px;">
            Download PDF
          </a>

    </div>

</body>

</html>