<!DOCTYPE html>
<html>
<head>
  <title>HireAI | Interview Summary</title>
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <link rel="stylesheet" href="/css/output.css">
</head>
<body>
  <%- include("../partials/navbar") %>

  <main class="app-shell py-8 sm:py-12">
    <section class="card p-6 sm:p-8">
      <h1 class="page-title">Interview Summary</h1>

      <div class="mt-4 flex flex-wrap items-center gap-3 text-sm">
        <p class="rounded-lg bg-[#F5EDE6] px-3 py-2"><span class="font-semibold">Role:</span> <%= interview.role %></p>
        <p class="rounded-lg bg-[#F5EDE6] px-3 py-2"><span class="font-semibold">Level:</span> <%= interview.level %></p>
      </div>

      <p class="mt-4 text-sm">
        <span class="font-semibold">Average Score:</span>
        <span class="rounded-full px-3 py-1 text-xs font-semibold <%= interview.averageScore >= 7 ? 'bg-emerald-100 text-emerald-700' : interview.averageScore >= 4 ? 'bg-amber-100 text-amber-700' : 'bg-rose-100 text-rose-700' %>">
          <%= interview.averageScore %> / 10
        </span>
      </p>

      <div class="mt-6 space-y-4 border-t border-[#9CA3AF]/40 pt-6">
        <% interview.questions.forEach((q, index) => { %>
          <article class="rounded-xl border border-[#9CA3AF]/40 bg-white p-5">
            <h2 class="text-lg font-semibold text-[#1F2937]">Question <%= index + 1 %></h2>
            <p class="mt-3 text-sm text-[#4B5563]"><span class="font-semibold text-[#1F2937]">Question:</span> <%= q.question %></p>
            <p class="mt-3 text-sm font-semibold text-[#1F2937]">Your Answer:</p>
            <p class="mt-1 text-sm leading-relaxed text-[#374151]"><%= q.answer %></p>

            <p class="mt-4 text-sm font-semibold text-[#1F2937]">Feedback:</p>
            <pre class="mt-1 whitespace-pre-wrap rounded-lg bg-[#F9FAFB] p-4 text-xs leading-relaxed text-[#374151]"><%= q.feedback %></pre>

            <p class="mt-4 text-sm">
              <span class="font-semibold">Score:</span>
              <span class="rounded-full px-3 py-1 text-xs font-semibold <%= q.score >= 7 ? 'bg-emerald-100 text-emerald-700' : q.score >= 4 ? 'bg-amber-100 text-amber-700' : 'bg-rose-100 text-rose-700' %>">
                <%= q.score %> / 10
              </span>
            </p>
          </article>
        <% }) %>
      </div>

      <div class="mt-6 flex flex-wrap gap-3">
        <a href="/setup" class="btn-primary">Start New Interview</a>
        <a href="/summary/<%= interview._id %>/pdf" class="btn-secondary">Download PDF</a>
      </div>
    </section>
  </main>
</body>
</html>
