<!DOCTYPE html>
<html>
<head>
  <title>HireAI | Interview History</title>
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <link rel="stylesheet" href="/css/output.css">
</head>
<body>
  <%- include("../partials/navbar") %>

  <main class="app-shell py-8 sm:py-12">
    <section class="card p-6 sm:p-8">
      <h1 class="page-title">Interview History</h1>
      <p class="page-subtitle">
        <span class="font-medium text-[#1F2937]"><%= user.username %></span>
        (<%= user.email %>)
      </p>

      <% if (interviews.length === 0) { %>
        <p class="mt-8 rounded-xl border border-dashed border-[#9CA3AF] p-6 text-center text-[#4B5563]">
          No interviews yet.
        </p>
      <% } %>

      <div class="mt-6 grid gap-4 sm:grid-cols-2 xl:grid-cols-3">
        <% interviews.forEach(interview => { %>
          <article class="rounded-xl border border-[#9CA3AF]/40 bg-white p-5">
            <div class="flex flex-wrap items-center gap-3">
              <p class="text-sm"><span class="font-semibold">Role:</span> <%= interview.role %></p>
              <p class="text-sm"><span class="font-semibold">Level:</span> <%= interview.level %></p>
            </div>

            <p class="mt-3 text-sm">
              <span class="font-semibold">Average Score:</span>
              <span class="rounded-full px-3 py-1 text-xs font-semibold <%= interview.averageScore >= 7 ? 'bg-emerald-100 text-emerald-700' : interview.averageScore >= 4 ? 'bg-amber-100 text-amber-700' : 'bg-rose-100 text-rose-700' %>">
                <%= interview.averageScore %> / 10
              </span>
            </p>

            <p class="mt-3 text-xs text-[#6B7280]">
              <%= new Date(interview.createdAt).toLocaleString() %>
            </p>

            <a href="/summary/<%= interview._id %>" class="btn-secondary mt-4">View Summary</a>
          </article>
        <% }) %>
      </div>
    </section>
  </main>
</body>
</html>
