<!DOCTYPE html>
<html>
<head>
  <title>HireAI | Analytics</title>
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <link rel="stylesheet" href="/css/output.css">
  <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
</head>
<body>
  <%- include("../partials/navbar") %>

  <main class="app-shell py-8 sm:py-12">
    <% if (labels.length === 0) { %>
      <section class="card p-6 sm:p-8">
        <h1 class="page-title">Your Interview Progress</h1>
        <p class="page-subtitle">No interviews yet. Start your first mock interview to see analytics.</p>
      </section>
    <% } else { %>
      <div class="grid gap-6 lg:grid-cols-3">
        <section class="card p-6 lg:col-span-1">
          <h1 class="page-title text-xl">Key Stats</h1>
          <div class="mt-5 space-y-3">
            <a href="/history" class="block rounded-xl border border-[#9CA3AF]/40 bg-white p-4 transition hover:bg-[#F9FAFB]">
              <p class="text-sm text-[#4B5563]">Total Interviews</p>
              <p class="mt-1 text-2xl font-bold text-[#1F2937]"><%= totalInterviews %></p>
            </a>

            <% if (bestInterviewId) { %>
              <a href="/summary/<%= bestInterviewId %>" class="block rounded-xl border border-[#9CA3AF]/40 bg-white p-4 transition hover:bg-[#F9FAFB]">
                <p class="text-sm text-[#4B5563]">Best Score</p>
                <p class="mt-1 text-2xl font-bold text-emerald-700"><%= bestScore %> / 10</p>
              </a>
            <% } %>

            <% if (latestInterviewId) { %>
              <a href="/summary/<%= latestInterviewId %>" class="block rounded-xl border border-[#9CA3AF]/40 bg-white p-4 transition hover:bg-[#F9FAFB]">
                <p class="text-sm text-[#4B5563]">Latest Score</p>
                <p class="mt-1 text-2xl font-bold text-[#14B8A6]"><%= latestScore %> / 10</p>
              </a>
            <% } %>
          </div>
        </section>

        <section class="card p-6 lg:col-span-2">
          <h2 class="page-title text-xl">Score Progress Over Time</h2>
          <div class="mt-4 h-80">
            <canvas id="progressChart"></canvas>
          </div>
        </section>
      </div>
    <% } %>
  </main>

  <% if (labels.length > 0) { %>
    <script>
      const labels = <%- labels %>;
      const scores = <%- scores %>;
      const ctx = document.getElementById("progressChart");

      new Chart(ctx, {
        type: "line",
        data: {
          labels: labels,
          datasets: [{
            data: scores,
            borderColor: "#14B8A6",
            backgroundColor: "rgba(20,184,166,0.16)",
            tension: 0.35,
            fill: true,
            pointRadius: 4,
            pointHoverRadius: 6
          }]
        },
        options: {
          plugins: {
            legend: { display: false }
          },
          scales: {
            y: {
              beginAtZero: true,
              max: 10,
              title: {
                display: true,
                text: "Score (out of 10)"
              }
            },
            x: {
              title: {
                display: true,
                text: "Interview Date"
              }
            }
          }
        }
      });
    </script>
  <% } %>
</body>
</html>
