<!DOCTYPE html>
<html>
<head>
  <title>HireAi | Analytics</title>
  <link rel="stylesheet" href="/css/style.css">
  <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
</head>

<body>

  <%- include("../partials/navbar") %>

  <% if (labels.length === 0) { %>

    <!-- EMPTY STATE -->
    <div class="container" style="margin-top:40px;">
      <h2>Your Interview Progress</h2>
      <p style="margin-top:20px; color:#555;">
        No interviews yet. Start your first mock interview to see analytics.
      </p>
    </div>

  <% } else { %>

    <!-- DASHBOARD LAYOUT -->
    <div style="display:flex; gap:24px; max-width:1200px; margin:40px auto;">

      <!-- LEFT BIG CARD -->
      <div class="container" style="flex:1;">
        <h2>Your Interview Progress</h2>

        <!-- INNER CLICKABLE STAT CARDS -->
        <div style="display:flex; gap:16px; margin-top:25px;">

          <!-- TOTAL INTERVIEWS -->
          <a
            href="/history"
            style="flex:1; text-decoration:none; color:inherit;"
          >
            <div class="container" style="text-align:center; cursor:pointer;">
              <h4>Total Interviews</h4>
              <p style="font-size:24px; font-weight:600;">
                <%= totalInterviews %>
              </p>
            </div>
          </a>

          <!-- BEST SCORE -->
          <% if (bestInterviewId) { %>
          <a
            href="/summary/<%= bestInterviewId %>"
            style="flex:1; text-decoration:none; color:inherit;"
          >
            <div class="container" style="text-align:center; cursor:pointer;">
              <h4>Best Score</h4>
              <p style="font-size:24px; font-weight:600;">
                <%= bestScore %> / 10
              </p>
            </div>
          </a>
          <% } %>

          <!-- LATEST SCORE -->
          <% if (latestInterviewId) { %>
          <a
            href="/summary/<%= latestInterviewId %>"
            style="flex:1; text-decoration:none; color:inherit;"
          >
            <div class="container" style="text-align:center; cursor:pointer;">
              <h4>Latest Score</h4>
              <p style="font-size:24px; font-weight:600;">
                <%= latestScore %> / 10
              </p>
            </div>
          </a>
          <% } %>

        </div>
      </div>

      <!-- RIGHT GRAPH CARD -->
      <div class="container" style="flex:1.3;">
        <h2>Score Progress Over Time</h2>
        <canvas id="progressChart" height="160"></canvas>
      </div>

    </div>

  <% } %>

  <% if (labels.length > 0) { %>
  <script>
    const labels = <%- labels %>;
    const scores = <%- scores %>;

    const ctx = document.getElementById("progressChart");

    new Chart(ctx, {
      type: "line",
      data: {
        labels: labels,
        datasets: [{
          data: scores,
          borderColor: "#4f46e5",
          backgroundColor: "rgba(79,70,229,0.15)",
          tension: 0.4,
          fill: true,
          pointRadius: 5,
          pointHoverRadius: 7
        }]
      },
      options: {
        plugins: {
          legend: { display: false }
        },
        scales: {
          y: {
            beginAtZero: true,
            max: 10,
            title: {
              display: true,
              text: "Score (out of 10)"
            }
          },
          x: {
            title: {
              display: true,
              text: "Interview Date"
            }
          }
        }
      }
    });
  </script>
  <% } %>

</body>
</html>
