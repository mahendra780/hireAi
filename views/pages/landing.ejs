<!DOCTYPE html>
<html>

<head>
  <title>HireAI | AI Mock Interview Platform</title>
  <link rel="stylesheet" href="/css/style.css">
  <!-- <link rel="stylesheet" href="/css/home.css"> -->
  <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;600;700;800&display=swap" rel="stylesheet">
</head>

<body>

  <%- include("../partials/navbar") %>

    <!-- HERO SECTION -->
    <section class="hero">
      <div class="hero-content">
        <span class="badge">Free AI Practice</span>

        <h1>
          AI Powered <br> Mock Interviews
        </h1>

        <p>
          Practice with an intelligent AI interviewer, get instant feedback,
          and boost your confidence for every job interview.
        </p>

        <div class="hero-buttons">
          <% if (!currentUser) { %>
            <a href="/signup" class="btn-primary">Start Free</a>
            <% } else { %>
              <a href="/setup" class="btn-primary">Continue Interview</a>
              <% } %>

                <a href="#features" class="btn-secondary">Explore Features</a>
        </div>
      </div>
    </section>


    <!-- FEATURES SECTION -->
    <section id="features" class="features">
      <h2>Why Choose HireAI?</h2>

      <div class="feature-grid">
        <div class="feature-card">
          <h3>🎯 Role-Based Questions</h3>
          <p>Get tailored interview questions based on your job role and level.</p>
        </div>

        <div class="feature-card">
          <h3>⚡ Instant AI Feedback</h3>
          <p>Receive structured feedback, scoring, and improvement tips instantly.</p>
        </div>

        <div class="feature-card">
          <h3>📈 Confidence Boost</h3>
          <p>Practice anytime and track your progress to improve consistently.</p>
        </div>
      </div>
    </section>


    <!-- HOW IT WORKS -->
    <section class="how">
      <h2>How It Works</h2>

      <div class="steps">
        <div class="step">
          <span>1</span>
          <h4>Select Role</h4>
          <p>Choose your target job and experience level.</p>
        </div>

        <div class="step">
          <span>2</span>
          <h4>Answer Questions</h4>
          <p>Respond to AI-generated interview questions.</p>
        </div>

        <div class="step">
          <span>3</span>
          <h4>Get Feedback</h4>
          <p>Receive score, strengths & improvement areas.</p>
        </div>
      </div>
    </section>


    <footer class="footer">
      © <%= new Date().getFullYear() %> HireAI · Prepare Smarter
    </footer>

</body>

</html>