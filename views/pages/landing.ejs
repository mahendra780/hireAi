<!DOCTYPE html>
<html>
<head>
  <title>HireAi | Mock Interview Platform</title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>

  <!-- NAVBAR -->
  <%- include("../partials/navbar") %>

  <!-- HERO SECTION -->
  <section class="hero">
    <div class="hero-left fade-up">
      <h1 class="delay-1">
        AI-powered Mock <br />
        Interview Practice
      </h1>

      <p class="delay-2">
        Ace your next job interview with zero stress. Build confidence,
        sharpen your answers, and get real-time AI feedback to improve
        like a pro.
      </p>

      <div class="hero-actions delay-3">
        <% if (!currentUser) { %>
          <a href="/signup">
            <button class="btn hero-btn">Start Now</button>
          </a>
        <% } else { %>
          <a href="/setup">
            <button class="btn hero-btn">Continue Interview</button>
          </a>
        <% } %>
      </div>
    </div>

    <div class="hero-right fade-up delay-2">
      <div class="hero-circle"></div>

      <!-- OPTIONAL IMAGE -->
      <img src="/images/hero.png" alt="Mock Interview" class="hero-image" />

      
    </div>
  </section>

  <!-- FEATURES SECTION -->
  <section style="margin-top: 80px;">
    <h3 style="text-align:center;" class="fade-up">Why HireAi?</h3>

    <div
      style="
        display:flex;
        gap:20px;
        justify-content:center;
        margin-top:40px;
        flex-wrap:wrap;
      "
    >
      <div class="feature-card fade-up delay-1"
        style="width:260px;padding:20px;border:1px solid #e5e7eb;border-radius:12px;">
        <h4>AI Questions</h4>
        <p style="color:#555;">
          Get role-based interview questions generated by AI.
        </p>
      </div>

      <div class="feature-card fade-up delay-2"
        style="width:260px;padding:20px;border:1px solid #e5e7eb;border-radius:12px;">
        <h4>Instant Feedback</h4>
        <p style="color:#555;">
          Receive detailed feedback and score after every answer.
        </p>
      </div>

      <div class="feature-card fade-up delay-3"
        style="width:260px;padding:20px;border:1px solid #e5e7eb;border-radius:12px;">
        <h4>Practice Ready</h4>
        <p style="color:#555;">
          Practice interviews anytime and improve your confidence.
        </p>
      </div>
    </div>
  </section>

  <!-- HOW IT WORKS SECTION -->
  <section style="margin-top: 100px;">
    <h3 style="text-align:center;" class="fade-up">How It Works</h3>

    <div
      style="
        display:flex;
        justify-content:center;
        gap:30px;
        margin-top:40px;
        flex-wrap:wrap;
        text-align:center;
      "
    >
      <div class="fade-up delay-1" style="width:220px;">
        <h4>1️⃣ Choose Role</h4>
        <p style="color:#555;">
          Select your job role and experience level.
        </p>
      </div>

      <div class="fade-up delay-2" style="width:220px;">
        <h4>2️⃣ Answer Questions</h4>
        <p style="color:#555;">
          Respond to AI-generated interview questions.
        </p>
      </div>

      <div class="fade-up delay-3" style="width:220px;">
        <h4>3️⃣ Get Feedback</h4>
        <p style="color:#555;">
          Receive instant feedback and score.
        </p>
      </div>
    </div>
  </section>

  <!-- FOOTER -->
  <footer class="footer fade-up delay-2">
    <p>
      © <%= new Date().getFullYear() %> HireAi ·
      Prepare smarter interviews
    </p>
  </footer>

</body>
</html>
